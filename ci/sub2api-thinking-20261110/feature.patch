+package service
+
+import (
+    "strings"
+
+    "github.com/Wei-Shaw/sub2api/internal/pkg/claude"
+    "github.com/tidwall/gjson"
+    "github.com/tidwall/sjson"
+)
+
+// HideThinkingOutputEnabled is an opt-in per-account presentation setting.
+// The setting does not disable model reasoning or change usage accounting.
+func (a *Account) HideThinkingOutputEnabled() bool {
+    if a == nil || a.Extra == nil { return false }
+    enabled, ok := a.Extra["hide_thinking_output"].(bool)
+    return ok && enabled
+}
+
+// omitAnthropicThinkingText asks supported Claude models not to return readable
+// thinking text. It preserves native signatures and signed message history.
+// For models/protocols without an omission contract, return the body unchanged;
+// stripping reasoning from signed multi-turn transcripts is unsafe.
+func omitAnthropicThinkingText(body []byte, model string, enabled bool) []byte {
+    if !enabled || !gjson.ValidBytes(body) { return body }
+    model = strings.TrimSpace(model)
+    if model == "" { model = gjson.GetBytes(body, "model").String() }
+    thinkingType := gjson.GetBytes(body, "thinking.type").String()
+    if claude.IsOpus55(model) || claude.IsSonnet55(model) || claude.IsHaiku55(model) {
+        // The Sonnet 5.5 between_tools mode intentionally disallows display.
+        if thinkingType != "" && thinkingType != "adaptive" { return body }
+        next, err := sjson.SetBytes(body, "thinking.type", "adaptive")
+        if err != nil { return body }
+        next, err = sjson.SetBytes(next, "thinking.display", "omitted")
+        if err == nil { return next }
+        return body
+    }
+    // On other Claude models, both manual extended thinking (enabled) and
+    // adaptive thinking accept display=omitted. Preserve their mode and budget.
+    // Never synthesize a new thinking mode for older models.
+    if strings.HasPrefix(strings.ToLower(model), "claude-") && (thinkingType == "adaptive" || thinkingType == "enabled") {
+        next, err := sjson.SetBytes(body, "thinking.display", "omitted")
+        if err == nil { return next }
+    }
+    return body
+}
+
+
+// omitGeminiThinkingText prevents exposure of plaintext thought parts without
+// changing thinking level, thinking budget, or signed tool-call history.
+// Absent includeThoughts already defaults to false; do not synthesize fields.
+func omitGeminiThinkingText(body []byte, enabled bool) []byte {
+    if !enabled || !gjson.ValidBytes(body) { return body }
+    next := body
+    for _, path := range []string{
+        "generationConfig.thinkingConfig.includeThoughts",
+        "generation_config.thinking_config.include_thoughts",
+    } {
+        if !gjson.GetBytes(next, path).Exists() { continue }
+        if updated, err := sjson.SetBytes(next, path, false); err == nil {
+            next = updated
+        }
+    }
+    return next
+}
+
+// omitOpenAIReasoningSummary leaves model reasoning and any opaque state intact;
+// it only removes the client's explicit request for a readable summary.
+func omitOpenAIReasoningSummary(body []byte, enabled bool) []byte {
+    if !enabled || !gjson.GetBytes(body, "reasoning.summary").Exists() { return body }
+    next, err := sjson.DeleteBytes(body, "reasoning.summary")
+    if err != nil { return body }
+    if gjson.GetBytes(next, "reasoning").IsObject() && len(gjson.GetBytes(next, "reasoning").Map()) == 0 {
+        if cleaned, deleteErr := sjson.DeleteBytes(next, "reasoning"); deleteErr == nil { return cleaned }
+    }
+    return next
+}
