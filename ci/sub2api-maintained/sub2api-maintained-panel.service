[Unit]
Description=Sub2API web panel updater
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/sub2api-maintained-panel.py
RuntimeDirectory=sub2api-maintained-panel
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=3s
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
