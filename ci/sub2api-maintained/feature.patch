+package service
+
+import (
+ "testing"
+ "github.com/stretchr/testify/require"
+ "github.com/tidwall/gjson"
+)
+
+func TestHideThinkingOutputPerAccount(t *testing.T) {
+ require.False(t, (&Account{}).HideThinkingOutputEnabled())
+ require.False(t, (&Account{Extra: map[string]any{"hide_thinking_output": "true"}}).HideThinkingOutputEnabled())
+ require.True(t, (&Account{Extra: map[string]any{"hide_thinking_output": true}}).HideThinkingOutputEnabled())
+}
+func TestOmitAnthropicThinkingText(t *testing.T) {
+ original := []byte(`{"model":"claude-opus-5-5","messages":[{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":"keep-signed"}]}]}`)
+ out := omitAnthropicThinkingText(original, "claude-opus-5-5", true)
+ // A display-only flag must not enable adaptive reasoning on its own.
+ require.Equal(t, string(original), string(out))
+ requested := []byte(`{"model":"claude-opus-5-5","thinking":{"type":"adaptive"},"output_config":{"effort":"max"},"messages":[{"role":"assistant","content":[{"type":"thinking","thinking":"","signature":"keep-signed"}]}]}`)
+ out = omitAnthropicThinkingText(requested, "claude-opus-5-5", true)
+ require.Equal(t, "omitted", gjson.GetBytes(out, "thinking.display").String())
+ require.Equal(t, "adaptive", gjson.GetBytes(out, "thinking.type").String())
+ require.Equal(t, "max", gjson.GetBytes(out, "output_config.effort").String())
+ require.Equal(t, "keep-signed", gjson.GetBytes(out, "messages.0.content.0.signature").String())
+ require.Equal(t, string(original), string(omitAnthropicThinkingText(original,"claude-opus-5-5",false)))
+ b := []byte(`{"model":"claude-sonnet-5-5","thinking":{"type":"between_tools"}}`)
+ require.Equal(t, string(b),string(omitAnthropicThinkingText(b,"claude-sonnet-5-5",true)))
+ b=[]byte(`{"model":"claude-haiku-4-5","thinking":{"type":"enabled","budget_tokens":1024}}`)
+ require.Equal(t,"omitted",gjson.GetBytes(omitAnthropicThinkingText(b,"claude-haiku-4-5",true),"thinking.display").String())
+ require.Equal(t,"enabled",gjson.GetBytes(omitAnthropicThinkingText(b,"claude-haiku-4-5",true),"thinking.type").String())
+ require.Equal(t,int64(1024),gjson.GetBytes(omitAnthropicThinkingText(b,"claude-haiku-4-5",true),"thinking.budget_tokens").Int())
+}
+
+
+func TestOmitGeminiThinkingTextPreservesEffortAndSignature(t *testing.T) {
+    original := []byte(`{"generationConfig":{"thinkingConfig":{"thinkingLevel":"high","includeThoughts":true}},"contents":[{"parts":[{"functionCall":{"name":"lookup"},"thoughtSignature":"opaque"}]}]}`)
+    visible := omitGeminiThinkingText(original, false)
+    require.Equal(t, string(original), string(visible))
+    omitted := omitGeminiThinkingText(original, true)
+    require.False(t, gjson.GetBytes(omitted, "generationConfig.thinkingConfig.includeThoughts").Bool())
+    require.Equal(t, "high", gjson.GetBytes(omitted, "generationConfig.thinkingConfig.thinkingLevel").String())
+    require.Equal(t, "opaque", gjson.GetBytes(omitted, "contents.0.parts.0.thoughtSignature").String())
+}
+
+func TestOmitOpenAIReasoningSummaryPreservesEffort(t *testing.T) {
+    original := []byte(`{"model":"gpt-6","reasoning":{"effort":"high","summary":"auto"},"input":"hello"}`)
+    require.Equal(t, string(original), string(omitOpenAIReasoningSummary(original, false)))
+    omitted := omitOpenAIReasoningSummary(original, true)
+    require.False(t, gjson.GetBytes(omitted, "reasoning.summary").Exists())
+    require.Equal(t, "high", gjson.GetBytes(omitted, "reasoning.effort").String())
+    require.Equal(t, "hello", gjson.GetBytes(omitted, "input").String())
+}
+
+func TestRedactAnthropicThinkingSSELine(t *testing.T) {
+    thinking := `data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":"private summary"}}`
+    cleaned := redactAnthropicThinkingSSELine(thinking, true)
+    require.Equal(t, "", gjson.Get(cleaned[6:], "delta.thinking").String())
+    require.Equal(t, "thinking_delta", gjson.Get(cleaned[6:], "delta.type").String())
+    require.Equal(t, int64(0), gjson.Get(cleaned[6:], "index").Int())
+    require.Equal(t, thinking, redactAnthropicThinkingSSELine(thinking, false))
+    require.Equal(t, cleaned, redactAnthropicThinkingSSELine(cleaned, true))
+
+    signature := `data: {"type":"content_block_delta","index":0,"delta":{"type":"signature_delta","signature":"opaque-full-thinking"}}`
+    require.Equal(t, signature, redactAnthropicThinkingSSELine(signature, true))
+    tool := `data: {"type":"content_block_start","index":1,"content_block":{"type":"tool_use","id":"toolu_1","name":"test","input":{}}}`
+    require.Equal(t, tool, redactAnthropicThinkingSSELine(tool, true))
+    text := `data: {"type":"content_block_delta","index":2,"delta":{"type":"text_delta","text":"Final answer"}}`
+    require.Equal(t, text, redactAnthropicThinkingSSELine(text, true))
+    usage := `data: {"type":"message_delta","usage":{"output_tokens":41253}}`
+    require.Equal(t, usage, redactAnthropicThinkingSSELine(usage, true))
+    invalid := "data: {invalid"
+    require.Equal(t, invalid, redactAnthropicThinkingSSELine(invalid, true))
+}
+
+func TestRedactAnthropicThinkingJSON(t *testing.T) {
+    original := []byte(`{"content":[{"type":"thinking","thinking":"sensitive summary","signature":"opaque"},{"type":"tool_use","id":"toolu_1","name":"test","input":{"x":1}},{"type":"text","text":"Done"}],"usage":{"output_tokens":41253}}`)
+    require.Equal(t, string(original), string(redactAnthropicThinkingJSON(original,false)))
+    cleaned := redactAnthropicThinkingJSON(original,true)
+    require.Equal(t, "", gjson.GetBytes(cleaned,"content.0.thinking").String())
+    require.Equal(t, "opaque", gjson.GetBytes(cleaned,"content.0.signature").String())
+    require.Equal(t, "toolu_1", gjson.GetBytes(cleaned,"content.1.id").String())
+    require.Equal(t, int64(1), gjson.GetBytes(cleaned,"content.1.input.x").Int())
+    require.Equal(t, "Done", gjson.GetBytes(cleaned,"content.2.text").String())
+    require.Equal(t, int64(41253), gjson.GetBytes(cleaned,"usage.output_tokens").Int())
+}

