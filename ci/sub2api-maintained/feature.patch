@@ -0,0 +1,65 @@
+package service
+
+import (
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/Wei-Shaw/sub2api/internal/config"
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+	"github.com/tidwall/gjson"
+)
+
+func TestAnthropicPassthroughRedactsThinkingAtResponseBoundary(t *testing.T) {
+	service := &GatewayService{cfg: &config.Config{}}
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name string
+		hide bool
+		want string
+	}{
+		{name: "hidden", hide: true, want: ""},
+		{name: "visible", hide: false, want: "readable"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			account := &Account{Extra: map[string]any{"hide_thinking_output": tc.hide}}
+			req := httptest.NewRequest(http.MethodPost, "/v1/messages", nil)
+
+			rec := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(rec)
+			c.Request = req
+			body := `{"type":"message","content":[{"type":"thinking","thinking":"readable","signature":"opaque"},{"type":"text","text":"Answer"}],"usage":{"input_tokens":5,"output_tokens":42}}`
+			resp := &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(body))}
+			usage, err := service.handleNonStreamingResponseAnthropicAPIKeyPassthrough(req.Context(), resp, c, account)
+			require.NoError(t, err)
+			require.Equal(t, 42, usage.OutputTokens)
+			require.Equal(t, tc.want, gjson.Get(rec.Body.String(), "content.0.thinking").String())
+			require.Equal(t, "opaque", gjson.Get(rec.Body.String(), "content.0.signature").String())
+			require.Equal(t, "Answer", gjson.Get(rec.Body.String(), "content.1.text").String())
+
+			rec = httptest.NewRecorder()
+			c, _ = gin.CreateTestContext(rec)
+			c.Request = req
+			lines := []string{
+				`data: {"type":"message_start","message":{"usage":{"input_tokens":5}}}`,
+				`data: {"type":"content_block_delta","index":0,"delta":{"type":"thinking_delta","thinking":"readable"}}`,
+				`data: {"type":"content_block_delta","index":0,"delta":{"type":"signature_delta","signature":"opaque"}}`,
+				`data: {"type":"content_block_delta","index":1,"delta":{"type":"text_delta","text":"Answer"}}`,
+				`data: {"type":"message_delta","usage":{"output_tokens":42}}`,
+				`data: {"type":"message_stop"}`,
+			}
+			resp = &http.Response{StatusCode: http.StatusOK, Body: io.NopCloser(strings.NewReader(strings.Join(lines, "\n\n") + "\n\n"))}
+			result, err := service.handleStreamingResponseAnthropicAPIKeyPassthrough(req.Context(), resp, c, account, time.Now(), "claude-opus-5-5")
+			require.NoError(t, err)
+			require.Equal(t, 42, result.usage.OutputTokens)
+			events := strings.Split(strings.TrimSpace(rec.Body.String()), "\n\n")
+			require.Len(t, events, len(lines))
+			require.Equal(t, tc.want, gjson.Get(strings.TrimPrefix(events[1], "data: "), "delta.thinking").String())
+			require.Equal(t, lines[2:], events[2:])
+		})
+	}
+}
