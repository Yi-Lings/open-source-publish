diff --git a/backend/internal/service/gateway_hide_thinking.go b/backend/internal/service/gateway_hide_thinking.go
new file mode 100644
index 0000000..6f0286c
--- /dev/null
+++ b/backend/internal/service/gateway_hide_thinking.go
@@ -0,0 +1,195 @@
+package service
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/Wei-Shaw/sub2api/internal/pkg/claude"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// HideThinkingOutputEnabled is an opt-in per-account presentation setting.
+// The setting does not disable model reasoning or change usage accounting.
+func (a *Account) HideThinkingOutputEnabled() bool {
+	if a == nil || a.Extra == nil {
+		return false
+	}
+	enabled, ok := a.Extra["hide_thinking_output"].(bool)
+	return ok && enabled
+}
+
+// omitAnthropicThinkingText asks supported Claude models not to return readable
+// thinking text. It preserves native signatures and signed message history.
+// For models/protocols without an omission contract, return the body unchanged;
+// stripping reasoning from signed multi-turn transcripts is unsafe.
+func omitAnthropicThinkingText(body []byte, model string, enabled bool) []byte {
+	if !enabled || !gjson.ValidBytes(body) {
+		return body
+	}
+	model = strings.TrimSpace(model)
+	if model == "" {
+		model = gjson.GetBytes(body, "model").String()
+	}
+	thinkingType := gjson.GetBytes(body, "thinking.type").String()
+	if claude.IsOpus55(model) || claude.IsSonnet55(model) || claude.IsHaiku55(model) {
+		// Do not turn on adaptive thinking if the client did not request it.
+		// Newer models already default to omitted display. Preserve the
+		// requested mode, budget, and effort to avoid unintended extra cost.
+		if thinkingType != "adaptive" {
+			return body
+		}
+		next, err := sjson.SetBytes(body, "thinking.display", "omitted")
+		if err == nil {
+			return next
+		}
+		return body
+	}
+	// On other Claude models, both manual extended thinking (enabled) and
+	// adaptive thinking accept display=omitted. Preserve their mode and budget.
+	// Never synthesize a new thinking mode for older models.
+	if strings.HasPrefix(strings.ToLower(model), "claude-") && (thinkingType == "adaptive" || thinkingType == "enabled") {
+		next, err := sjson.SetBytes(body, "thinking.display", "omitted")
+		if err == nil {
+			return next
+		}
+	}
+	return body
+}
+
+// omitGeminiThinkingText prevents exposure of plaintext thought parts without
+// changing thinking level, thinking budget, or signed tool-call history.
+// Absent includeThoughts already defaults to false; do not synthesize fields.
+func omitGeminiThinkingText(body []byte, enabled bool) []byte {
+	if !enabled || !gjson.ValidBytes(body) {
+		return body
+	}
+	next := body
+	for _, path := range []string{
+		"generationConfig.thinkingConfig.includeThoughts",
+		"generation_config.thinking_config.include_thoughts",
+	} {
+		if !gjson.GetBytes(next, path).Exists() {
+			continue
+		}
+		if updated, err := sjson.SetBytes(next, path, false); err == nil {
+			next = updated
+		}
+	}
+	return next
+}
+
+// omitOpenAIReasoningSummary leaves model reasoning and any opaque state intact;
+// it only removes the client's explicit request for a readable summary.
+func omitOpenAIReasoningSummary(body []byte, enabled bool) []byte {
+	if !enabled || !gjson.GetBytes(body, "reasoning.summary").Exists() {
+		return body
+	}
+	next, err := sjson.DeleteBytes(body, "reasoning.summary")
+	if err != nil {
+		return body
+	}
+	if gjson.GetBytes(next, "reasoning").IsObject() && len(gjson.GetBytes(next, "reasoning").Map()) == 0 {
+		if cleaned, deleteErr := sjson.DeleteBytes(next, "reasoning"); deleteErr == nil {
+			return cleaned
+		}
+	}
+	return next
+}
+
+// redactAnthropicReadableThinkingEvent only alters client-visible plaintext.
+// Signed deltas and content-block boundaries must remain intact for tool-use
+// round trips, including models with encrypted thinking history.
+func redactAnthropicReadableThinkingEvent(event map[string]any) bool {
+	if event == nil {
+		return false
+	}
+	switch event["type"] {
+	case "content_block_start":
+		block, ok := event["content_block"].(map[string]any)
+		if ok && block["type"] == "thinking" {
+			if txt, ok := block["thinking"].(string); ok && txt != "" {
+				block["thinking"] = ""
+				return true
+			}
+		}
+	case "content_block_delta":
+		delta, ok := event["delta"].(map[string]any)
+		if ok && delta["type"] == "thinking_delta" {
+			if txt, ok := delta["thinking"].(string); ok && txt != "" {
+				delta["thinking"] = ""
+				return true
+			}
+		}
+	case "message_start":
+		if msg, ok := event["message"].(map[string]any); ok {
+			return redactAnthropicThinkingContent(msg)
+		}
+	}
+	return false
+}
+
+func redactAnthropicThinkingContent(msg map[string]any) bool {
+	items, ok := msg["content"].([]any)
+	if !ok {
+		return false
+	}
+	changed := false
+	for _, item := range items {
+		b, ok := item.(map[string]any)
+		if !ok || b["type"] != "thinking" {
+			continue
+		}
+		if txt, ok := b["thinking"].(string); ok && txt != "" {
+			b["thinking"] = ""
+			changed = true
+		}
+	}
+	return changed
+}
+
+// Applied after usage accounting, just before sending downstream JSON.
+func redactAnthropicThinkingJSON(body []byte, enabled bool) []byte {
+	if !enabled {
+		return body
+	}
+	var msg map[string]any
+	if json.Unmarshal(body, &msg) != nil {
+		return body
+	}
+	if !redactAnthropicThinkingContent(msg) {
+		return body
+	}
+	output, err := json.Marshal(msg)
+	if err != nil {
+		return body
+	}
+	return output
+}
+
+// Applied to a single SSE data line (event framing remains unmodified).
+// Invalid JSON is passed through; valid thinking deltas are emptied.
+func redactAnthropicThinkingSSELine(line string, enabled bool) string {
+	if !enabled {
+		return line
+	}
+	if !strings.HasPrefix(line, "data:") {
+		return line
+	}
+	start := len("data:")
+	for start < len(line) && (line[start] == ' ' || line[start] == '\t') {
+		start++
+	}
+	var obj map[string]any
+	if json.Unmarshal([]byte(line[start:]), &obj) != nil {
+		return line
+	}
+	if !redactAnthropicReadableThinkingEvent(obj) {
+		return line
+	}
+	b, err := json.Marshal(obj)
+	if err != nil {
+		return line
+	}
+	return line[:start] + string(b)
+}
